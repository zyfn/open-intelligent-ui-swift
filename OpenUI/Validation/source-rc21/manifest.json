  "repairs": [
    {
      "id": "supported-motion-fixture",
      "reason": "accessibilityReduceMotion is read-only. Use the existing presentation motion setting and a disabled-animation transaction for final-artwork snapshots; preserve every pixel assertion."
    },
    {
      "id": "loaded-card-artwork-fixture",
      "reason": "A missing image is transparent and cannot establish loaded image geometry. Load a deterministic red PNG through the real resource and hosting lifecycle, preserve all original edge/inset coordinates and color thresholds, and additionally assert that missing artwork leaves the white surface visible."
    },
    {
      "id": "zod-security",
      "reason": "Pin Zod 4.6.7 and independently regenerate the source core with the explicitly reviewed JSON Schema export compatibility transform. Record the source-specific builder/adapter digest and exact dependency transform hashes. The strict oracle digest changes with its dependency; all semantic expectations remain unchanged.",
      "advisory": "GHSA-mrhx-c7xc-m3w5"
    },
    {
      "id": "katex-security",
      "reason": "Pin and override KaTeX 0.18.2 for the direct and transitive dependency, then independently regenerate original rich-text resources with its unchanged builder.",
      "advisory": "GHSA-238p-pmpm-9mq7"
    },
    {
      "id": "zod-schema-format",
      "reason": "Share the exact-version and exact-source-hash checked Zod JSON Schema compatibility plugin between the source core and catalog builders. Disable only the new compactTypeUnion export-format pass, preserving the existing anyOf representation, nesting and key order. Keep Zod 4.6.7 parsing, validators and collection security fixes unchanged; retain the original catalog bytes."
    },
    {
      "id": "public-generator-registries",
      "reason": "Replace Alibaba registry tarball origins in the three source presentation locks with registry.npmjs.org. Package versions, integrity digests and all other package metadata stay identical; verify fresh installation using a new cache and zero-vulnerability audits."
    }
  ],
