{
  "domain": "Components",
  "version": 1,
  "cases": [
    {
      "id": "CP-001",
      "objective": "组件注册、参数与 writer/reader 契约",
      "workload": "遍历 OpenUI 与 OpenIntelligentUI 全部组件及条件注册组件",
      "environment": "macOS · XCTest",
      "assertions": [
        "writer 只暴露允许新生成的组件",
        "reader 仅接受当前注册组件及明确保留的历史字段",
        "签名参数顺序与实现一致"
      ],
      "metrics": [
        "组件契约通过率",
        "未覆盖组件数"
      ],
      "evidence": [
        "Tests/SwiftOpenUITests",
        "Tests/SwiftIntelligentUITests/GenerationContractTests.swift"
      ],
      "status": "existing"
    },
    {
      "id": "CP-002",
      "objective": "控件交互、绑定与动作",
      "workload": "Input、Select、Checkbox、Button、Form、Popover 组合",
      "environment": "iOS/macOS · XCTest",
      "assertions": [
        "用户输入写入正确绑定",
        "无 action 控件不可误触发",
        "动作参数与源数据一致"
      ],
      "metrics": [
        "交互成功率",
        "状态回写次数"
      ],
      "evidence": [
        "Tests/SwiftIntelligentUITests"
      ],
      "status": "planned"
    },
    {
      "id": "CP-003",
      "objective": "媒体与异步资源生命周期",
      "workload": "图片成功、失败、重试、快速替换、卸载和重新挂载",
      "environment": "iOS/macOS · XCTest",
      "assertions": [
        "旧请求不能回填新内容",
        "占位与真实状态一致",
        "资源按生命周期释放"
      ],
      "metrics": [
        "加载延迟",
        "缓存命中率",
        "峰值内存"
      ],
      "evidence": [
        "Tests/SwiftIntelligentUITests/ImagePipelineTests.swift",
        "Tests/SwiftIntelligentUITests/MediaRegressionTests.swift"
      ],
      "status": "existing"
    }
  ]
