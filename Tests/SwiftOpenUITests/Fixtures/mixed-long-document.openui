// Public synthetic stress input; contains no customer conversation or service data.
// Target: about 200 reachable element identities and a long phone-width document.
// Height must be measured on the target platform; this is not a Muse replay.
root = Stack([section01, section02, section03, section04, section05, section06, section07, section08, section09, section10, section11, section12, section13, section14, section15, section16, section17, section18, section19, section20, section21, section22, section23, section24, notesForm], "column", "l")
readingBody = "This is a public synthetic reading sample. Each section repeats a fixed mixture of paragraphs, a small table, and a short summary so that layout work can be compared without private conversation data.\n\n这段文字用于检查较窄阅读宽度下的自然换行。内容长度、标点和段落边界保持固定；切换宽度时应重新计算高度，再次回到原宽度时应恢复相同的阅读布局。\n\n- **保持内容完整**：列表、强调和普通文字共同参与排版。\n- `stable-source` 是普通代码片段，不执行任何程序。\n- [公开示例链接](https://example.com/reading) 只用于链接布局。\n\n完成加载后，重复测量不应重新提交语言源码。这个样本不代表真实会话，也没有经过设备性能等价验证。"

section01 = Card([
  TextContent("Synthetic section 01 · 公开阅读样本", "large-heavy"),
  MarkDownRenderer(readingBody, "clear"),
  TextContent("区段 01 的摘要用于检查正文与表格之间的间距。页面宽度变化后，内容顺序、链接和输入状态仍应保持。"),
  Table([
    Col("Item", ["Sample 01-A","Sample 01-B","Sample 01-C","Sample 01-D"]),
    Col("Description", ["Fixed public data","Independent row text","A longer label wraps","No network request"]),
    Col("Value", [1,2,3,4])
  ])
], "clear")

