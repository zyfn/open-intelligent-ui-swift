        "对比度与状态含义可辨",
        "显式样式覆盖规则正确"
      ],
      "metrics": [
        "token mismatch count",
        "contrast findings"
      ],
      "evidence": [
        "Tests/SwiftIntelligentUITests/SemanticTypographyTests.swift",
        "Gallery"
      ],
      "status": "existing"
    },
    {
