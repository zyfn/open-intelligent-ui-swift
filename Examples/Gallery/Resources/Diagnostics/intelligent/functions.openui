root = Col([Title("函数与计算", "lg"), Input($budget,"预算","number"), Text($budget == null || $budget < 0 ? "请输入非负预算" : "三人分摊：" + @Join(@Allocate($budget,[1,1,1])," / ")), Text("摄氏转华氏：" + @Convert(20,"c","f")), Text("固定日期加 7 天：" + @AddDays("2026-11-01",7)), Table(["统计","结果"],[["平均值",@Stats([10,20,30]).mean],["中位数",@Stats([10,20,30]).median]]), Button("记录计算结果", @ToAssistant("检查分摊", {shares:@Allocate($budget,[1,1,1])}), "outline", "primary", "md", null, $budget == null || $budget < 0)])
$budget = 100
