root = Stack([TextContent("输入草稿与表单状态", "large-heavy"), TextContent("尝试中文、超长备注和无效邮箱。提交后查看诊断面板中的 action 与 formState。"), Form("diagnostic", Buttons([Button("记录提交", @ToAssistant("检查当前表单"))]), [FormControl("名称", Input("name", "必填名称", "text", {required:true})), FormControl("邮箱", Input("email", "name@example.com", "email", {email:true})), FormControl("备注", TextArea("notes", "长段落与多行输入", 3))])])
