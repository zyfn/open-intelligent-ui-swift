root = Col([heading,intro,comparison,products,checklist,next,boundary])
heading = Title("阅读台灯，先看怎么摆，再看买哪一盏","xl")
intro = Text("这三条商品记录对应不同的摆放方式。先确定桌面空间、电源位置和是否能夹装，再回到具体商品页核对尺寸与规格。")
comparison = Table(["候选","先判断的使用条件"],[["惠普折叠阅读台灯","桌面能否容纳底座；灯臂展开后会不会挡视线"],["欧普充电折叠台灯","放置位置与充电习惯；实际续航、接口和供电方式待核对"],["充电夹式阅读台灯","桌边是否可夹装；夹口范围、稳定性与线缆位置待核对"]])
products = Grid([hp,opple,clip],3,250,4)
hp = ProductCard({id:"971628097659",title:"惠普折叠阅读台灯",images:[{url:"https://img.alicdn.com/imgextra/i1/2216436773929/O1CN010S8AcDt6spH1chua_!!4611686018427384873-0-item_pic.jpg",alt:"惠普折叠阅读台灯原商品图"}],price:84,currency:"CNY",merchant:"惠普照明旗舰店",observedAt:"2026-11-10",priceNote:"原示例记录，当前价格和库存待重新查询",purchaseURL:"https://detail.tmall.com/item.htm?id=971628097659",actionLabel:"查看商品"},"vertical","contain")
opple = ProductCard({id:"1014479690931",title:"欧普充电折叠台灯",images:[{url:"https://img.alicdn.com/imgextra/i3/138006397/O1CN01GESzBaCMA9E1chua-138006397.jpg",alt:"欧普充电折叠台灯原商品图"}],price:116.2,currency:"CNY",merchant:"欧普照明官方旗舰店",observedAt:"2026-11-10",priceNote:"原示例记录，当前价格和库存待重新查询",purchaseURL:"https://detail.tmall.com/item.htm?id=1014479690931",actionLabel:"查看商品"},"vertical","contain")
clip = ProductCard({id:"1087331917809",title:"充电夹式阅读台灯",images:[{url:"https://img.alicdn.com/imgextra/i3/2217254400585/O1CN01wHFlHoptgGH1chua_!!2217254400585-0-C2M.jpg",alt:"充电夹式阅读台灯原商品图"}],price:49.9,currency:"CNY",merchant:"国货严选旗舰",observedAt:"2026-11-10",priceNote:"原示例记录，当前价格和库存待重新查询",purchaseURL:"https://detail.tmall.com/item.htm?id=1087331917809",actionLabel:"查看商品"},"vertical","contain")
checklist = Card([Title("下单前，核对这些实测信息","sm"),List(["底座尺寸或夹口范围，是否适合你的桌面。","灯臂可调范围与灯头位置，会不会挡住屏幕或产生眩光。","阅读区域实际照明覆盖，以及具体型号的光学参数。","供电接口、线长和充电要求；不要从名称推定续航。"]),Text("折叠、充电、夹式仅沿用既有商品名称，不据此推定便携性、续航或护眼效果。","sm","muted")])
next = Button("按我的桌面条件缩小选择",@ToAssistant("请先问我的桌面尺寸、摆放位置和供电条件，再帮我核对这三条台灯记录；不要用其他型号的资料补齐参数。",{productIDs:["971628097659","1014479690931","1087331917809"]}),"outline")
boundary = Caption("商品身份、图片、店铺、金额和链接来自原示例，未在本次重新验证。价格是 2026-11-10 的历史记录；点击只进入原商品地址，不提交订单。")
