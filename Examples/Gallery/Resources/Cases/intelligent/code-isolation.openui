root = Col([heading,answer,boundaries,options,architecture,controls,operations,example,sources,next])
heading = Title("让 Agent 执行用户代码，隔离边界应该放在哪？","xl")
answer = Text("如果要执行用户或模型生成的任意代码，优先把风险放进独立的虚拟机边界，再决定怎样提供容器式的部署体验。选择运行时只是其中一层，还需要资源、网络、凭据和生命周期控制。")
boundaries = Card([Title("先区分两种边界","sm"),Table(["方式","核心隔离关系"],[["普通 Docker / runc","进程通过 namespaces、cgroups 和 seccomp 等机制隔离，但共享宿主机内核"],["虚拟机或 microVM","任务在 guest kernel 中运行，通过 hypervisor 与宿主隔离；仍需维护 VMM 和宿主安全"]]),Caption("容器镜像和虚拟机边界可以组合使用。不能仅凭“用容器运行”推定任意不可信代码已经获得独立内核隔离。")])
options = Col([Title("四种路线各解决什么","lg"),Table(["路线","边界与适用判断","需要验证"],[["Docker / runc","共享宿主内核；更适合受控的内部任务","权限、内核攻击面与宿主暴露"],["gVisor","用户态应用内核减少直接宿主系统调用面","系统调用兼容性与 I/O 性能"],["Kata Containers","以 VM 隔离承载 Pod 的容器工作流","Kubernetes 集成、RuntimeClass 与运维"],["Firecracker","基于 KVM 的轻量 microVM，适合高密度短任务平台","镜像、调度、网络、回收与整个平台运维"]]),Text("Kata 和 Firecracker 处在不同层次，不能当作完全互斥的同类开关；应按实际集成方式评估。","sm","muted")])
architecture = Card([Title("把调度与执行边界分开","sm"),Svg([Rect(75,10,210,45,"surface","muted",1,1,8),SvgText("API / Agent",180,39,20,"ink","middle","semibold"),Line(180,55,180,80,"info",2),Rect(75,80,210,45,"surface","muted",1,1,8),SvgText("任务调度器",180,109,20,"ink","middle","semibold"),Line(180,125,90,155,"info",2),Line(180,125,270,155,"info",2),Rect(15,155,150,60,"surface","info",2,1,8),SvgText("沙箱 A",90,191,20,"ink","middle","semibold"),Rect(195,155,150,60,"surface","info",2,1,8),SvgText("沙箱 B",270,191,20,"ink","middle","semibold"),Rect(15,245,330,45,"surface","muted",1,1,8),SvgText("受控的宿主资源池",180,274,20,"ink","middle","semibold")],"0 0 360 305",360,305),Caption("调度器分配任务给独立沙箱；宿主资源池承载沙箱。图只表达职责和边界，不是一份可直接上线的网络拓扑。")])
controls = Col([Title("无论选哪条路线，都要明确这些约束","lg"),List([ListItem("资源与时间","限制 CPU、内存、PID、磁盘、运行时长和日志体积，超限后终止并回收。"),ListItem("网络","默认限制外连，按任务需要开放出口；不要让执行环境任意接触内部服务。"),ListItem("凭据与挂载","不挂宿主 Docker socket，不注入宿主云凭据或不必要的 ServiceAccount token。"),ListItem("用户与会话","不同租户的任意代码不共享可写执行环境。按任务或按会话分配沙箱时，明确状态能保留多久。")])])
operations = Disclosure("短任务、Agent 会话与 warm pool 怎么取舍？",[Text("一次性任务便于在结束后整体销毁；多轮 Agent 会话可能需要暂存文件和进程，但必须定义过期、重置和租户归属。"),Text("Warm pool 可以减少冷启动等待，同时增加预热、清理、补充与版本更新的生命周期工作。不要把“复用实例”当成自动可靠的性能优化。")])
example = Disclosure("Kubernetes 示例：显式选择 RuntimeClass",[Code("apiVersion: v1\nkind: Pod\nmetadata:\n  name: user-code-runner\nspec:\n  runtimeClassName: kata-qemu-runtime-rs\n  automountServiceAccountToken: false\n  restartPolicy: Never\n  containers:\n    - name: runner\n      image: your-runner-image:tag\n      resources:\n        limits:\n          cpu: '1'\n          memory: 512Mi","yaml"),Caption("RuntimeClass 名称依赖集群配置，镜像名是占位符。示例不包含完整网络、存储、超时和清理策略；基于 KVM 的路线还需确认宿主支持。")])
sources = Citation([{title:"Kubernetes RuntimeClass",url:"https://kubernetes.io/docs/concepts/containers/runtime-class/"},{title:"Kata Containers virtualization design",url:"https://github.com/kata-containers/kata-containers/blob/main/docs/design/virtualization.md"},{title:"gVisor architecture",url:"https://gvisor.dev/docs/architecture_guide/intro/"},{title:"Firecracker specification",url:"https://github.com/firecracker-microvm/firecracker/blob/main/SPECIFICATION.md"}])
next = Button("按我的运行环境做取舍",@ToAssistant("请先了解我的平台是否有 Kubernetes 和 KVM、任务持续时间、语言依赖与租户隔离要求，再比较执行沙箱路线。"),"outline")
