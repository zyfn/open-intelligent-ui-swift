root = Col([heading,hero,intro,dayOne,dayTwo,comparison,places,ticket,next,boundary])
heading = Title("杭州两日：从南宋遗址走到西湖文人","xl")
hero = Image("https://p9.itc.cn/q_70/images03/20221030/ec6c914e9d9e483bb46ef2e1359a2d8b.jpeg","德寿宫红墙与建筑")
intro = Text("第一天集中看南宋历史，第二天沿西湖寻找文人足迹。每一天保留一条主线，路上留出休息时间。")
dayOne = Col([Title("第一天 · 南宋历史","lg"),List([ListItem("南宋官窑博物馆","从器物与官窑背景开始，建立对南宋生活和审美的直观认识。","1"),ListItem("德寿宫","把红墙、院落和地下遗址放在一起看，留出完整参观时间。","2"),ListItem("南宋遗址陈列馆","继续了解城址与考古线索；是否顺路接入，以当天开放安排和体力为准。","3")],"number",true),Grid([guanYao,deShou],2,240,4)])
guanYao = ImageText({title:"先看器物，再看遗址",image:{url:"https://www.hangchow.org/data/upload/ueditor/20230106/63b787c317c37.jpg",alt:"南宋官窑博物馆场景"},body:"官窑博物馆提供器物切口，与德寿宫的空间体验互补。"},"top")
deShou = ImageText({title:"德寿宫：院落与遗址",image:{url:"https://imagecloud.thepaper.cn/thepaper/image/225/370/576.jpg",alt:"德寿宫建筑入口"},body:"提前核对参观与预约安排；本页不提供实时余量。"},"top")
dayTwo = Col([Title("第二天 · 西湖文人","lg"),List([ListItem("苏堤","沿湖慢走，不必一次走遍所有支路。","1"),ListItem("岳王庙","看祠庙、墓区与碑刻，把历史人物和现场空间联系起来。","2"),ListItem("孤山与林逋遗迹","把节奏放慢，留出沿湖停留的时间。","3")],"number",true),Grid([suDi,yueMiao,guShan],3,220,4),Caption("苏东坡纪念馆在苏堤南端一侧，可作为另一段安排；不要把它当作岳王庙旁边顺手可达的一站。")])
suDi = ImageText({title:"苏堤",image:{url:"https://img1.qunarzz.com/travel/d0/1508/b5/86a1839a0346a8.jpg_r_720x480x95_04ad6f0a.jpg",alt:"苏堤湖岸风景"},body:"以步行和看湖为主。"},"top")
yueMiao = ImageText({title:"岳王庙",image:{url:"https://www.pelago.com/img/products/CN-China/yue-fei-temple-ticket/df78b90c-88b1-4dcf-9345-0f32d6a6d728_yue-fei-temple-ticket.jpg",alt:"岳王庙建筑"},body:"以祠庙、墓区和碑刻为主。"},"top")
guShan = ImageText({title:"孤山",image:{url:"https://youimg1.c-ctrip.com/target/fd/tg/g1/M0B/C3/49/CghzflT_pLqAB8CTABhI6i-AH8Q373.jpg",alt:"孤山一带的湖山景色"},body:"串联文人故事与湖边漫步。"},"top")
comparison = Table(["地点","这次主要看什么"],[["南宋官窑博物馆","器物、官窑背景"],["德寿宫","院落、建筑、地下遗址"],["南宋遗址陈列馆","城址和考古线索"],["苏堤","西湖步行与景观"],["岳王庙","祠庙、墓区、碑刻"],["孤山","林逋遗迹与湖边停留"]])
places = Col([Title("两天地点的相对位置","sm"),Map([MapMarker("南宋官窑博物馆",30.21183,120.150447,"第一天"),MapMarker("德寿宫",30.2412,120.16862,"第一天"),MapMarker("南宋遗址陈列馆",30.23219,120.1652,"第一天"),MapMarker("苏堤",30.242637,120.134544,"第二天"),MapMarker("岳王庙",30.25474,120.12977,"第二天"),MapMarker("孤山",30.2542,120.138013,"第二天"),MapMarker("苏东坡纪念馆",30.231245,120.13929,"可选")],false),Caption("位置图不提供道路导航；开放时间、转场方式和预约需要出发前重新确认。")])
ticket = ProductCard({id:"hangzhou-yuewang-temple",title:"岳王庙成人票",images:[{url:"https://www.pelago.com/img/products/CN-China/yue-fei-temple-ticket/df78b90c-88b1-4dcf-9345-0f32d6a6d728_yue-fei-temple-ticket.jpg",alt:"岳王庙建筑"}],price:25,currency:"CNY",priceNote:"起 · 原示例成人票记录，具体日期、票种和优惠待重新查询",purchaseURL:"https://touch.piao.qunar.com/touch/detail.htm?id=3501705640",actionLabel:"查看票种"},"horizontal")
next = Button("按我的体力细化两天节奏",@ToAssistant("请沿南宋历史与西湖文人两条主线细化杭州两日行程，先问我的步行能力，再重新确认开放和预约信息。"),"outline")
boundary = Caption("票价、照片和场馆信息保留原示例语境，不是实时查询。购买入口只打开原地址，不代表完成预订。")
