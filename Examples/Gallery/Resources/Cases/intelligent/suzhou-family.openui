root = Col([heading,hero,intro,transport,stay,dayOne,dayTwo,places,tickets,budget,checklist,next,boundary])
heading = Title("带父母去苏州，留一点慢下来的余地","xl")
hero = Image("https://www.suzhou.gov.cn/szsrmzf/tpxw/202507/8d91434b0f83493aa6cf9ad9e7f9033e/images/d106b03438da47c4b48176a3b817421c.jpg","苏州平江路河道、游船与沿岸步行场景")
intro = Text("2026 年 11 月 21–22 日，3 位成人、两间房住一晚。一天一个园林，老街只走短段，安排回酒店休息的余地。日期、车程和住宿预算是本案例的演示条件。")
transport = Col([Title("先固定往返的时间框架","lg"),Grid([outbound,inbound],2,300,4),Button("去 12306 重新查询",@OpenUrl("https://www.12306.cn/index/"),"outline"),Caption("两程都是 mock：每人每程 ¥60，3 人每程 ¥180，往返合计 ¥360。未提供真实车次、余票或出票承诺。")])
outbound = TransportCard({id:"suzhou-outbound-demo",legs:[{mode:"train",from:"上海站",to:"苏州站",departureDate:"2026-11-21",arrivalDate:"2026-11-21",departureTime:"09:30",arrivalTime:"10:05",departureZone:"UTC+8",arrivalZone:"UTC+8",durationText:"35 分钟"}],price:60,currency:"CNY",priceNote:"演示预算 · 每成人单程",durationText:"35 分钟",badge:"去程 · mock"})
inbound = TransportCard({id:"suzhou-inbound-demo",legs:[{mode:"train",from:"苏州站",to:"上海站",departureDate:"2026-11-22",arrivalDate:"2026-11-22",departureTime:"16:30",arrivalTime:"17:05",departureZone:"UTC+8",arrivalZone:"UTC+8",durationText:"35 分钟"}],price:60,currency:"CNY",priceNote:"演示预算 · 每成人单程",durationText:"35 分钟",badge:"返程 · mock"})
stay = Col([Title("住一晚，先确认房型需求","lg"),ProductCard({id:"ac-hotel-suzhou-china",title:"AC Hotel Suzhou China",images:[{url:"https://cache.marriott.com/is/image/marriotts7prod/ar-wuxsa-entrance-25469:Wide-Hor?wid=1336&fit=constrain",alt:"苏州 AC 酒店官网入口照片"}],price:590,currency:"CNY",priceNote:"每间每晚的演示预算，不是已查到的房价",specification:"姑苏区人民路 1585 号；需要两间房、一晚，希望一间双床与一间大床。",condition:"房型可售情况、早餐和退改条件未查询；周边施工情况需确认。",purchaseURL:"https://www.marriott.com/en-us/hotels/wuxsa-ac-hotel-suzhou-china/overview/",actionLabel:"查看酒店"},"horizontal"),Caption("房间需求不代表已确认库存。两间房 × 一晚 × 每间 ¥590，住宿预算合计 ¥1,180。")])
dayOne = Col([Title("第一天 · 拙政园和一小段平江路","lg"),List([ListItem("上午到达，先安顿","到苏州后先去酒店寄存或休息，是否能提前入住需另行确认。","1"),ListItem("下午看拙政园","以中部池景、亭榭和树木为主，先按 60–90 分钟留时间，累了就停。","2"),ListItem("傍晚短走平江路","挑一小段街巷，坐下来喝茶或吃饭，不把整条街走完当目标。","3")],"number",true),Grid([zhuoZheng,pingJiang],2,250,4)])
zhuoZheng = ImageText({title:"拙政园",image:{url:"https://ylj.suzhou.gov.cn/szdoc/szsylj/uploadfile/bg5naimiu1e.jpg",alt:"拙政园池水与亭榭"},body:"以水为主，沿池景慢慢看。"},"top")
pingJiang = ImageText({title:"平江路",image:{url:"https://news.2500sz.com/uploadfiles/202602/21/2026022109200146823428.jpg",alt:"平江路街巷与水岸"},body:"只挑一段散步，把休息留在计划里。"},"top")
dayTwo = Col([Title("第二天 · 留园，山塘街按体力选","lg"),List([ListItem("上午看留园","给庭院、曲廊、冠云峰和漏窗留 60–90 分钟，不赶每一个点。","1"),ListItem("山塘街作为可选项","如果父母愿意继续走，短走一段；否则直接休息。","2"),ListItem("15:00 前结束游览","取行李并为去车站留出余量，对应演示的 16:30 返程。","3")],"number",true),Grid([liuYuan,shanTang],2,250,4)])
liuYuan = ImageText({title:"留园",image:{url:"https://p1.itc.cn/q_70/images03/20211230/6d7f3cb169064fdf9c92c85896302271.jpeg",alt:"留园庭院与建筑"},body:"庭院、曲廊和漏窗适合放慢脚步看。"},"top")
shanTang = ImageText({title:"山塘街 · 可选",image:{url:"https://cdn-ak.f.st-hatena.com/images/fotolife/s/suzhoushenghuo/20240603/20240603112852.jpg",alt:"山塘街水岸与建筑"},body:"不挤占返程缓冲，体力允许再加入。"},"top")
places = Col([Title("四处游览点的位置","sm"),Map([MapMarker("拙政园",31.32647,120.62473,"第一天"),MapMarker("平江路",31.31493,120.62969,"第一天"),MapMarker("留园",31.31762,120.58827,"第二天"),MapMarker("山塘街",31.3201,120.59745,"可选")],false),Caption("地图只用于位置判断，具体转场与实时交通需要另查。")])
tickets = Card([Title("门票先按成人公示价占位","sm"),Table(["园林","11 月淡季成人价"],[["拙政园","¥70"],["留园","¥45"]]),Text("原示例公示口径：旺季为 4、5、7–10 月，对应成人价 ¥80 / ¥55。父母是否适用优惠与预约规则未确认，因此不把成人价直接乘以 3。","sm","muted"),Button("查看园林门票公示",@OpenUrl("https://ylj.suzhou.gov.cn/szsylj/mpjg/wztt.shtml"),"outline")])
budget = Table(["已设定的演示预算","3 人合计"],[["往返铁路","¥360"],["两间房住一晚","¥1,180"],["上述两项小计","¥1,540"],["门票、餐饮、市内交通","待确认，不计入上述小计"]])
checklist = Card([Title("真正出发前再核对","sm"),List(["日期和实际车次；车站、出发时刻与到站时间。","两间房的床型、到店安排、施工影响与退改条件。","园林预约时段、父母优惠条件与所需证件。","父母可接受的连续步行时间，随时可以删掉可选街巷。"])])
next = Button("按父母的步行能力再减量",@ToAssistant("请沿这份苏州两日计划，先问父母的连续步行能力，再删减景点；车次、酒店与门票都要重新查询，不能使用示例预算当报价。"),"outline")
boundary = Caption("本页是静态演示行程。照片和场馆材料保留原示例来源；交通、住宿预算与用房需求均不代表实时库存或已完成预订。")
