root = Col([heading,intro,comparison,current,tradeoff,history,boundary])
heading = Title("北京到曼谷：直飞和中转，按同一天比较","xl")
intro = Text("统一条件：2026-11-21、1 位成人、单程经济舱、演示价含税。先比较时间与中转负担，再决定需要重新查询哪种方案。")
comparison = Table(["同日演示方案","直飞 A","上海浦东中转 B"],[["出发 / 到达当地时间","10:00 → 14:05","09:00 → 16:00"],["总用时","5 小时 5 分","8 小时"],["中转","无","上海浦东，同机场衔接 2 小时"],["演示价","¥950","¥820"],["到达日","11 月 21 日","11 月 21 日"]])
current = Grid([directChoice,transferChoice],2,300,4)
directChoice = Col([TransportCard({id:"same-day-direct-demo",legs:[{mode:"flight",from:"北京大兴",to:"曼谷素万那普",fromCode:"PKX",toCode:"BKK",departureDate:"2026-11-21",arrivalDate:"2026-11-21",departureTime:"10:00",arrivalTime:"14:05",departureZone:"UTC+8",arrivalZone:"UTC+7",durationText:"5 小时 5 分"}],price:950,currency:"CNY",priceNote:"mock · 1 成人单程经济舱含税",durationText:"5 小时 5 分",badge:"直飞 A · 同日演示"}),Button("重新查这天的直飞",@ToAssistant("请重新查询 2026-11-21 北京大兴到曼谷素万那普的直飞，1 位成人、单程经济舱，并核对含税总价、行李与退改。不能把本页 mock 当作实时航班。",{date:"2026-11-21",from:"PKX",to:"BKK",preference:"direct",adults:1}),"outline")])
transferChoice = Col([TransportCard({id:"same-day-transfer-demo",legs:[{mode:"flight",from:"北京大兴",to:"上海浦东",fromCode:"PKX",toCode:"PVG",departureDate:"2026-11-21",arrivalDate:"2026-11-21",departureTime:"09:00",arrivalTime:"11:00",departureZone:"UTC+8",arrivalZone:"UTC+8",durationText:"2 小时"},{mode:"flight",from:"上海浦东",to:"曼谷素万那普",fromCode:"PVG",toCode:"BKK",departureDate:"2026-11-21",arrivalDate:"2026-11-21",departureTime:"13:00",arrivalTime:"16:00",departureZone:"UTC+8",arrivalZone:"UTC+7",durationText:"4 小时"}],connections:[{afterLeg:0,location:"上海浦东",durationText:"2 小时",notice:"同机场衔接；是否联程、行李直挂及保障规则待查询",changeStation:false}],price:820,currency:"CNY",priceNote:"mock · 1 成人单程经济舱含税",durationText:"8 小时",badge:"中转 B · 同日演示"}),Button("重新查同日中转",@ToAssistant("请重新查询 2026-11-21 北京大兴到曼谷素万那普经上海浦东中转的方案，1 位成人、单程经济舱，核对是否联程、行李、转机保障与含税总价。不能把本页 mock 当作实时航班。",{date:"2026-11-21",from:"PKX",to:"BKK",via:"PVG",adults:1}),"outline")])
tradeoff = Card([Title("这一次示例里的取舍","sm"),Text("中转方案演示价少 ¥130，但总用时多 2 小时 55 分钟，并增加一次衔接。这个差价只在上面同日、同人数、同舱位口径内成立。"),Caption("北京与上海为 UTC+8，曼谷为 UTC+7；总时长不能只把两端钟面时间直接相减。")])
history = Disclosure("灵活日期：保留四条历史记录",[Text("以下是 2026-11-10 保留的历史示例，不是同日对比。每条链接仍对应自己卡片上的出发日期，不能用跨日期差价替代上方直飞与中转的比较。"),Grid([historicalDirect,historicalTransfer,alternativeA,alternativeB],2,300,4)])
historicalDirect = TransportCard({id:"historical-direct-nov27",legs:[{mode:"flight",from:"北京大兴",to:"曼谷素万那普",fromCode:"PKX",toCode:"BKK",departureDate:"2026-11-27",arrivalDate:"2026-11-28",departureTime:"23:45",arrivalTime:"03:50",departureZone:"UTC+8",arrivalZone:"UTC+7",arrivalDayOffset:1,carrier:"泰越捷航空",serviceNumber:"VZ3719",durationText:"5 小时 5 分"}],price:729,currency:"CNY",priceNote:"历史记录 · 每人单程经济舱",durationText:"5 小时 5 分",badge:"11/27 出发 · 历史",bookingURL:directUrl})
historicalTransfer = TransportCard({id:"historical-transfer-nov26",legs:[{mode:"flight",from:"北京大兴",to:"成都双流",fromCode:"PKX",toCode:"CTU",departureDate:"2026-11-26",arrivalDate:"2026-11-26",departureTime:"07:25",arrivalTime:"10:35",departureZone:"UTC+8",arrivalZone:"UTC+8",carrier:"中国东方航空",serviceNumber:"MU6641"},{mode:"flight",from:"成都天府",to:"曼谷素万那普",fromCode:"TFU",toCode:"BKK",departureDate:"2026-11-26",arrivalDate:"2026-11-26",departureTime:"15:05",arrivalTime:"17:15",departureZone:"UTC+8",arrivalZone:"UTC+7",carrier:"中国东方航空",serviceNumber:"MU5035"}],connections:[{afterLeg:0,location:"成都：双流 → 天府",durationText:"4 小时 30 分",notice:"需要换机场；地面交通、行李和联程保障待重新确认",changeStation:true}],price:721,currency:"CNY",priceNote:"历史记录 · 每人单程经济舱",durationText:"10 小时 50 分",badge:"11/26 出发 · 历史",bookingURL:transferUrl})
alternativeA = TransportCard({id:"historical-direct-nov18",legs:[{mode:"flight",from:"北京大兴",to:"曼谷素万那普",fromCode:"PKX",toCode:"BKK",departureDate:"2026-11-18",arrivalDate:"2026-11-19",departureTime:"23:45",arrivalTime:"03:50",departureZone:"UTC+8",arrivalZone:"UTC+7",arrivalDayOffset:1,carrier:"泰越捷航空",serviceNumber:"VZ3719",durationText:"5 小时 5 分"}],price:791,currency:"CNY",priceNote:"历史记录 · 每人单程经济舱",durationText:"5 小时 5 分",badge:"11/18 出发 · 历史",bookingURL:alternativeAUrl})
alternativeB = TransportCard({id:"historical-direct-nov22",legs:[{mode:"flight",from:"北京大兴",to:"曼谷素万那普",fromCode:"PKX",toCode:"BKK",departureDate:"2026-11-22",arrivalDate:"2026-11-23",departureTime:"23:45",arrivalTime:"03:50",departureZone:"UTC+8",arrivalZone:"UTC+7",arrivalDayOffset:1,carrier:"泰越捷航空",serviceNumber:"VZ3719",durationText:"5 小时 5 分"}],price:791,currency:"CNY",priceNote:"历史记录 · 每人单程经济舱",durationText:"5 小时 5 分",badge:"11/22 出发 · 历史",bookingURL:alternativeBUrl})
boundary = Caption("上方同日方案为 mock，未提供真实航空公司或航班号；下方历史记录未重新查价。行李、退改、库存及结算金额均以重新查询为准，打开历史链接不代表完成购买。")
