root = Col([heading,hero,intro,moods,choiceGuide,places,next,boundary])
heading = Title("杭州周末，换一种心情","xl")
hero = Image("https://upload.wikimedia.org/wikipedia/commons/e/ee/Aerial_panorama_of_West_Lake_and_its_surrounding_mountains._December_2023.jpg","西湖与周边群山的航拍全景")
intro = Text("先选想要的感觉，再决定去哪里。这里的四个方向是四种周末节奏，不需要一天全部走完。")
moods = Grid([lake,forest,oldTown,palace],2,250,4)
lake = ImageText({title:"湖边漫步 · 苏堤",image:{url:"https://img1.qunarzz.com/travel/d0/1508/b5/86a1839a0346a8.jpg_r_720x480x95_04ad6f0a.jpg",alt:"苏堤湖岸与树木"},body:"沿湖慢走，看水面和远山。适合想放空、随时停下来的半天。",badge:"轻松散步"},"top")
forest = ImageText({title:"山涧寻绿 · 九溪烟树",image:{url:"https://www.pelago.com/img/products/CN-China/half-day-hangzhou-nine-creeks-hiking-tour-with-tea-plantation-experience/862ecdad-1461-41c7-9853-78bc7f397cb4_half-day-hangzhou-nine-creeks-hiking-tour-with-tea-plantation-experience-xlarge.webp",alt:"九溪山间步道与绿意"},body:"把时间留给溪水、树荫和步行。愿意多走一些，可以单独安排半天。",badge:"自然绿意"},"top")
oldTown = ImageText({title:"老城烟火 · 南宋御街",image:{url:"https://photo.tuchong.com/1341903/f/268355055.jpg",alt:"南宋御街的老城街景"},body:"走街串巷、停下来吃点东西。适合不想安排紧密行程的城市漫游。",badge:"街巷闲逛"},"top")
palace = ImageText({title:"宋韵建筑 · 德寿宫",image:{url:"https://p9.itc.cn/q_70/images03/20221030/ec6c914e9d9e483bb46ef2e1359a2d8b.jpeg",alt:"德寿宫红墙与建筑"},body:"看红墙、院落和遗址展示，把一次参观作为半天的主线。",badge:"历史空间"},"top")
choiceGuide = Card([Title("按精力选，不按打卡数量选","sm"),Table(["今天的状态","先看哪里"],[["只想轻松走走","苏堤或南宋御街"],["愿意留出半天深入一点","九溪或德寿宫"]])])
places = Col([Title("先看相对位置","sm"),Map([MapMarker("苏堤",30.242637,120.134544,"湖边","🌿"),MapMarker("九溪烟树",30.204675,120.108564,"山林","🌲"),MapMarker("南宋御街",30.24483,120.166119,"街巷","🏘️"),MapMarker("德寿宫",30.2412,120.16862,"历史","🏛️")],false),Caption("地图用于理解四个地点的相对位置，不是一条建议全部走完的路线。")])
next = Row([Button("给我一个湖边半日安排",@ToAssistant("我想在杭州轻松沿湖走半天，请以苏堤为主安排，不要塞满景点。")),Button("沿德寿宫展开历史路线",@ToAssistant("我更喜欢宋韵建筑，请以德寿宫为主安排半天，并列出需要重新确认的预约信息。"),"outline")],3,"center","start",true)
boundary = Caption("照片与地点材料沿用原示例，仅用于挑选方向；不代表实时天气、人流或开放与预约状态。")
