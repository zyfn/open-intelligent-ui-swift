root = Col([heading,intro,trend,controls,summary,plan,boundary])
$period = "october"
home = $period=="quarter"?9000:3000
food = $period=="quarter"?4800:1800
transport = $period=="quarter"?1500:600
other = $period=="quarter"?2700:1200
heading = Title("花费增加，主要不在房租","xl")
intro = Text("10 月比 9 月多花 ¥800；住房没有变化，增量来自餐饮、交通和其他消费。")
trend = Col([Title("三个月，按同一口径看","lg"),Chart("bar",[{"月份":"8 月","住房":3000,"餐饮":1500,"交通":500,"其他":600},{"月份":"9 月","住房":3000,"餐饮":1500,"交通":400,"其他":900},{"月份":"10 月","住房":3000,"餐饮":1800,"交通":600,"其他":1200}],"月份",["住房","餐饮","交通","其他"],"currency","CNY",true,260),Table(["月份","合计"],[["8 月","¥5,600"],["9 月","¥5,800"],["10 月","¥6,600"]])])
controls = Col([Title("查看单月或三个月合计","sm"),SegmentedControl($period,[{value:"october",label:"只看 10 月"},{value:"quarter",label:"三个月合计"}],true)])
summary = Card([Title($period=="quarter"?"8–10 月合计 · ¥18,000":"10 月合计 · ¥6,600","lg"),Chart("donut",[{"类别":"住房","金额":home},{"类别":"餐饮","金额":food},{"类别":"交通","金额":transport},{"类别":"其他","金额":other}],"类别",["金额"],"currency","CNY",false,260),Table(["类别","金额"],[["住房",home],["餐饮",food],["交通",transport],["其他",other]])])
plan = Col([Title("11 月，先试一份 ¥6,000 的计划","lg"),Table(["类别","11 月计划","相比 10 月"],[["住房","¥3,000","保持不变"],["餐饮","¥1,500","少 ¥300"],["交通","¥500","少 ¥100"],["其他","¥1,000","少 ¥200"],["计划合计","¥6,000","少 ¥600"]]),Chart("bar",[{"类别":"住房","十月实际":3000,"十一月计划":3000},{"类别":"餐饮","十月实际":1800,"十一月计划":1500},{"类别":"交通","十月实际":600,"十一月计划":500},{"类别":"其他","十月实际":1200,"十一月计划":1000}],"类别",["十月实际","十一月计划"],"currency","CNY",false,260)])
boundary = Card([Title("计划不是预测","sm"),Text("金额只来自这份示例账单；月底按真实收据复盘，再调整下一月计划。切换统计范围只改变本页状态，没有连接个人账户或读取实际账单。")],"soft")
