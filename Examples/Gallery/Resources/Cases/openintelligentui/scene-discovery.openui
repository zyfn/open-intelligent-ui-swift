root = Col([cover,moods,choosing,places,closing,followUps ])
cover = Col([Caption("HANGZHOU · WEEKEND NOTES"),Title("杭州周末，换一种心情","xl"),Image("https://upload.wikimedia.org/wikipedia/commons/e/ee/Aerial_panorama_of_West_Lake_and_its_surrounding_mountains._December_2023.jpg","杭州西湖远景实拍，湖面、岛屿与远处群山"),Text("想在杭州出去走走，不一定要排满景点。先从四种截然不同的氛围里挑一个：湖边的松弛、山涧的绿意、老街的烟火，或宋韵建筑的细节。") ],3)
moods = Col([Title("四种周末，各有自己的节奏","lg"),Carousel([lake,forest,oldTown,palace],288,4),Caption("上面的照片来自不同日期的公开实景，仅用于辨认环境与氛围；不代表当前天气、人流或开放状态。") ],3)
lake = ImageText({title:"湖边漫步",image:{url:"https://img1.qunarzz.com/travel/d0/1508/b5/86a1839a0346a8.jpg_r_720x480x95_04ad6f0a.jpg",alt:"西湖苏堤沿湖步道与柳树实景"},body:"沿湖步道与柳树，走一段喜欢的风景。",badge:"苏堤",caption:"西湖西侧长堤，可任选一段步行"},"top")
forest = ImageText({title:"山涧寻绿",image:{url:"https://www.pelago.com/img/products/CN-China/half-day-hangzhou-nine-creeks-hiking-tour-with-tea-plantation-experience/862ecdad-1461-41c7-9853-78bc7f397cb4_half-day-hangzhou-nine-creeks-hiking-tour-with-tea-plantation-experience-xlarge.webp",alt:"杭州九溪烟树林荫溪流与石阶实景"},body:"林荫、溪流与石阶，留出步行的时间。",badge:"九溪烟树",caption:"西湖西南侧山谷，林荫与溪流步道"},"top")
oldTown = ImageText({title:"老城烟火",image:{url:"https://photo.tuchong.com/1341903/f/268355055.jpg",alt:"杭州南宋御街石板路、沿街店铺与行人实景"},body:"石板路与沿街店铺，慢慢逛老街。",badge:"南宋御街",caption:"上城区历史风貌商业街，适合闲逛"},"top")
palace = ImageText({title:"宋韵建筑",image:{url:"https://p9.itc.cn/q_70/images03/20221030/ec6c914e9d9e483bb46ef2e1359a2d8b.jpeg",alt:"杭州德寿宫红墙古树与游客实景"},body:"从红墙与建筑，看见宫苑遗址的层次。",badge:"德寿宫",caption:"上城区宫苑遗址博物馆，红墙与地下遗址"},"top")
choosing = Col([Title("按自己的状态选，不用四处都去","lg"),Grid([easy,deep],2,150,4) ],3)
easy = Card([Title("轻松走走，不想安排太满","sm"),Text("苏堤可以只走喜欢的一段；南宋御街适合边逛边吃，时间安排更灵活。")])
deep = Card([Title("愿意留出半天，认真体验","sm"),Text("九溪需要为步行留出余量；德寿宫则值得分别看地上建筑与地下遗址。")])
places = Col([Title("四个地点，大致在哪儿？","lg"),Map([MapMarker("苏堤 · 湖边漫步",30.242637,120.134544,"湖边","🌿"),MapMarker("九溪烟树 · 山涧寻绿",30.204675,120.108564,"山林","🌲"),MapMarker("南宋御街 · 老城烟火",30.24483,120.166119,"街巷","🏘️"),MapMarker("德寿宫 · 宋韵建筑",30.2412,120.16862,"历史","🏛️")],false),Caption("御街和德寿宫都在上城区一带；苏堤靠西湖，九溪更偏西南。地图是位置对照，不是建议一次走完四处的路线。") ],3)
closing = Col([Title("先选一种喜欢的感觉","lg"),Text("第一次来，想随意走走，可以从苏堤或南宋御街开始；若更喜欢山间自然，选九溪；偏爱历史建筑，就把时间留给德寿宫。选定方向后，再细化到出入口、交通与半日节奏。") ],3)
followUps = Col([Button("帮我把西湖散步安排成轻松的半日行程",@ToAssistant("帮我把西湖散步安排成轻松的半日行程")),Button("我更喜欢宋韵建筑，帮我细化德寿宫周边的半日安排",@ToAssistant("我更喜欢宋韵建筑，帮我细化德寿宫周边的半日安排"),"outline") ],3)
