root = Col([hero,introduction,transport,stay,dayOne,dayTwo,locationMap,tickets,budget,finish,next])
$datesChecked = false
$roomsChecked = false
$ticketsChecked = false
hero = Col([Caption("SHANGHAI → SUZHOU · 2 DAYS"),Title("苏州两天｜陪父母慢慢逛","xl"),Caption("2026/11/21–22 · 3 位成人 · 两天一晚"),Image("https://www.suzhou.gov.cn/szsrmzf/tpxw/202507/8d91434b0f83493aa6cf9ad9e7f9033e/images/d106b03438da47c4b48176a3b817421c.jpg","苏州平江路真实河道与游船，游客沿岸步行"),Text("不追求多打卡。把时间留给两座园林、两段老街，以及足够从容的吃饭和休息。")],3)
introduction = Col([Title("两天一晚 · 每天一座园林","lg"),Text("建议第一天看拙政园和平江路，第二天看留园和山塘街；跨片区优先打车，古街只走父母觉得舒服的一小段。"),Caption("住宿按 2 间客房、1 晚安排；父母同住一间，同行子女单独一间。")],3)
transport = Col([Title("往返交通","lg"),Text("去程上午抵达，返程放在第二天下午。两程都以苏州站接驳古城，车站与酒店之间安排打车。以下按直达高铁预留出行时段。"),Grid([outboundSection,inboundSection],2,300,4),Caption("往返交通预算 ¥360，未含市内接驳。时刻为行程预留安排，车次、票价及余票以 12306 查询结果为准。")],3)
outbound = TransportCard({id:"suzhou-outbound-demo",legs:[{mode:"train",from:"上海站",to:"苏州站",departureDate:"2026-11-21",arrivalDate:"2026-11-21",departureTime:"09:30",arrivalTime:"10:05",departureZone:"UTC+8",arrivalZone:"UTC+8",durationText:"35 分钟"}],price:60,currency:"CNY",priceNote:"演示预算 · 每成人单程",durationText:"35 分钟",badge:"去程 · mock"})
inbound = TransportCard({id:"suzhou-inbound-demo",legs:[{mode:"train",from:"苏州站",to:"上海站",departureDate:"2026-11-22",arrivalDate:"2026-11-22",departureTime:"16:30",arrivalTime:"17:05",departureZone:"UTC+8",arrivalZone:"UTC+8",durationText:"35 分钟"}],price:60,currency:"CNY",priceNote:"演示预算 · 每成人单程",durationText:"35 分钟",badge:"返程 · mock"})
outboundSection = Col([Caption("11/21 · 高铁二等座 · 3 位成人 · 计划时段"),outbound,Caption("3 人单程预算 ¥180，具体车次和发车时间以购票查询为准。"),Button("查询去程车次",@OpenUrl("https://www.12306.cn/index/"),"outline")],3)
inboundSection = Col([Caption("11/22 · 高铁二等座 · 3 位成人 · 计划时段"),inbound,Caption("3 人单程预算 ¥180；15:00 前结束游览，先取行李再前往车站。"),Button("查询返程车次",@OpenUrl("https://www.12306.cn/index/"),"outline")],3)
stay = Col([Title("住一晚｜古城里的落脚点","lg"),Text("以同一间酒店作为两天的起终点，减少带行李换住处的折腾。选择古城内的落脚点，方便衔接两天行程。"),hotel,Text("酒店以现代玻璃、石材结合江南白墙黑瓦的建筑元素；客房配有书桌和可调节阅读灯。"),Text("11/21 入住 · 11/22 退房 · 3 位成人\n用房需求：双床房 1 间 + 大床房 1 间，预订时确认可售房型。"),Caption("住宿按每间每晚 ¥590 预留预算，具体房型、早餐与退改条件以酒店查询为准。官网另提示周边施工，预订前需确认噪声影响与父母的出入需求。")],3)
hotel = ProductCard({id:"ac-hotel-suzhou-china",title:"AC Hotel Suzhou China",images:[{url:"https://cache.marriott.com/is/image/marriotts7prod/ar-wuxsa-entrance-25469:Wide-Hor?wid=1336&fit=constrain",alt:"AC Hotel Suzhou China 酒店入口"}],price:590,currency:"CNY",priceNote:"每间每晚预算 · 2 间 × 1 晚合计 ¥1,180",specification:"姑苏区 · 人民路 1585 号",purchaseURL:"https://www.marriott.com/en-us/hotels/wuxsa-ac-hotel-suzhou-china/overview/",actionLabel:"查看酒店"},"horizontal")
dayOne = Col([Title("Day 01｜园林与平江水巷","lg"),Caption("11 月 21 日 · 上午抵达，午后赏园，傍晚临河休息。"),arrival,gardenOne,canalOne],6)
arrival = Col([Title("上午 · 抵达苏州","md"),Caption("车站 → 酒店寄存行李 → 午饭休息"),Text("到站后优先打车前往酒店，安排午饭和休息，再开始逛园林。")],3)
gardenOne = Col([Title("午后 · 拙政园","md"),Caption("约 60–90 分钟 · 以中部水院与亭廊为主"),Image("https://ylj.suzhou.gov.cn/szdoc/szsylj/uploadfile/bg5naimiu1e.jpg","拙政园中花园池水与亭台实景，来源苏州市园林局"),Text("不必走遍全园。建议提前按游玩日期核对实名预约时段，遇到台阶和拥挤处放慢节奏。")],3)
canalOne = Col([Title("傍晚 · 平江路","md"),Caption("沿河走一小段，找间茶馆坐坐"),Image("https://news.2500sz.com/uploadfiles/202602/21/2026022109200146823428.jpg","苏州平江路傍晚河道、石桥、木船与临河街景"),Text("平江路公共街区免费。照片展示的是临河街景；人多时不必走完全程，休息比打卡重要。")],3)
dayTwo = Col([Title("Day 02｜留园与山塘旧街","lg"),Caption("11 月 22 日 · 上午游园，午后短逛，15:00 前结束游览取行李。"),gardenTwo,streetTwo,returnTwo],6)
gardenTwo = Col([Title("上午 · 留园","md"),Caption("约 60–90 分钟 · 冠云峰、窗景和回廊"),Image("https://p1.itc.cn/q_70/images03/20211230/6d7f3cb169064fdf9c92c85896302271.jpeg","苏州留园冠云峰与园林庭院实景"),Text("从酒店打车前往。把时间留给园林细节，累了就坐下休息。")],3)
streetTwo = Col([Title("午后 · 山塘街","md"),Caption("临河短走 · 苏式点心"),Image("https://cdn-ak.f.st-hatena.com/images/fotolife/s/suzhoushenghuo/20240603/20240603112852.jpg","苏州山塘街白天游船、石拱桥和沿河街景实拍"),Text("公共街区免费，照片展示石桥和沿河风貌。走累了可以取消这一站，直接回酒店取行李。")],3)
returnTwo = Col([Title("傍晚前 · 返回上海","md"),Caption("取行李 → 前往车站 → 返程"),Text("返程按 16:30 左右发车安排；先到酒店取行李，再打车到苏州站，留足进站时间。")],3)
locationMap = Col([Title("一张地图｜看清两天为什么顺路","lg"),Text("第一天在古城东北片区，第二天转向古城西侧。景点之间建议打车或短距离步行；地图用于对照景点位置，出行时按当日导航衔接。"),Map([MapMarker("拙政园",31.32647,120.62473,"第一天"),MapMarker("平江路",31.31493,120.62969,"第一天"),MapMarker("留园",31.31762,120.58827,"第二天"),MapMarker("山塘街",31.3201,120.59745,"可选")],false)],3)
tickets = Col([Title("门票与预约","lg"),Text("平江路、山塘街公共街区免费；两座园林需单独核对门票和入园时段。"),Carousel([ticketGardenOne,ticketGardenTwo],300,4),Caption("11 月按淡季公示价展示；旺季（4、5、7—10 月）分别为 ¥80、¥55。父母适用的年龄优惠与可约时段，请在官方渠道确认。")],3)
ticketGardenOne = ProductCard({id:"zhuozhengyuan",title:"拙政园",images:[{url:"https://ylj.suzhou.gov.cn/szdoc/szsylj/uploadfile/bg5naimiu1e.jpg",alt:"拙政园中花园池水与亭台实景"}],price:70,currency:"CNY",priceNote:"11 月淡季成人公示价 · 优惠待确认",specification:"11/21 · 下午计划入园。池水构成中部园景的核心，亭榭与树木沿水展开，呈现疏朗自然的江南园林格局。",purchaseURL:"https://ylj.suzhou.gov.cn/szsylj/mpjg/wztt.shtml",actionLabel:"查看票价"},"vertical")
ticketGardenTwo = ProductCard({id:"liuyuan",title:"留园",images:[{url:"https://p1.itc.cn/q_70/images03/20211230/6d7f3cb169064fdf9c92c85896302271.jpeg",alt:"留园冠云峰和园林庭院"}],price:45,currency:"CNY",priceNote:"11 月淡季成人公示价 · 优惠待确认",specification:"11/22 · 上午计划入园。以厅堂庭院、曲廊和湖石见长；冠云峰与漏窗相互借景，庭院空间层层变化。",purchaseURL:"https://ylj.suzhou.gov.cn/szsylj/mpjg/wztt.shtml",actionLabel:"查看票价"},"vertical")
budget = Col([Title("先把已知预算算清楚","lg"),Table(["已设定的演示预算","3 人合计"],[["往返铁路","¥360"],["两间房住一晚","¥1,180"],["上述两项小计","¥1,540"],["门票、餐饮、市内交通","待确认，不计入上述小计"]]),Caption("门票未把成人公示价直接乘以 3，父母优惠条件尚待确认。")],3)
finish = Col([Title("出发前，确认这三件事","lg"),Checkbox($datesChecked,"确认实际出行日期与车次"),Caption("按 11/21–22 安排，购票前确认实际车次与发车时间。"),Checkbox($roomsChecked,"同行人的房间安排"),Caption("确认人数、房间数、床型及退改条件。"),Checkbox($ticketsChecked,"两座园林的预约时段"),Caption("按实际游玩日期核对拙政园和留园的可约场次。"),Text("如果父母当天体力一般，宁可去掉一段老街，也不要把整趟旅行变成赶路。"),Caption("本页时刻与住宿金额为演示安排和预算，不代表实时库存或已完成预订。")],3)
next = Button("按父母的步行能力再减量",@ToAssistant("请沿这份苏州两日计划，先问父母的连续步行能力，再删减景点；车次、酒店与门票都要重新查询，不能使用示例预算当报价。"),"outline")
