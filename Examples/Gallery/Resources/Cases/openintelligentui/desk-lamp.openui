root = Col([lead,products,fit,closing ])
lead = Col([Caption("READING · A SMALL DESK"),Title("小书桌，选一盏真正好用的读书灯","xl"),Text("**小桌面先比较摆放方式，再看功能。** 折叠式方便收纳，夹式可以少占桌面；具体是否放得下，还要核对底座、夹口和灯臂尺寸。"),Caption("小桌面 · 阅读用途 · 先比较折叠与夹式") ],3)
