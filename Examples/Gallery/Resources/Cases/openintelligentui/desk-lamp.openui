hp = ProductCard({id:"971628097659",title:"惠普折叠阅读台灯",images:[{url:"https://img.alicdn.com/imgextra/i1/2216436773929/O1CN010S8AcDt6spH1chua_!!4611686018427384873-0-item_pic.jpg",alt:"惠普折叠阅读台灯商品图"}],price:84,currency:"CNY",merchant:"惠普照明旗舰店",specification:"面向桌面阅读场景的折叠式台灯。",tags:["折叠"],observedAt:"2026-11-10",priceNote:"历史记录 · 当前价格和库存待查询",purchaseURL:"https://detail.tmall.com/item.htm?id=971628097659",actionLabel:"查看商品"},"vertical","contain")
opple = ProductCard({id:"1014479690931",title:"欧普充电折叠台灯",images:[{url:"https://img.alicdn.com/imgextra/i3/138006397/O1CN01GESzBaCMA9E1chua-138006397.jpg",alt:"欧普充电折叠台灯商品图"}],price:116.2,currency:"CNY",merchant:"欧普照明官方旗舰店",specification:"充电式阅读台灯，灯体采用折叠结构。",tags:["充电","折叠"],observedAt:"2026-11-10",priceNote:"历史记录 · 当前价格和库存待查询",purchaseURL:"https://detail.tmall.com/item.htm?id=1014479690931",actionLabel:"查看商品"},"vertical","contain")
clip = ProductCard({id:"1087331917809",title:"充电夹式阅读台灯",images:[{url:"https://img.alicdn.com/imgextra/i3/2217254400585/O1CN01wHFlHoptgGH1chua_!!2217254400585-0-C2M.jpg",alt:"充电夹式阅读台灯商品图"}],price:49.9,currency:"CNY",merchant:"国货严选旗舰",specification:"采用夹式固定方式的充电阅读台灯。",tags:["夹式","充电"],observedAt:"2026-11-10",priceNote:"历史记录 · 当前价格和库存待查询",purchaseURL:"https://detail.tmall.com/item.htm?id=1087331917809",actionLabel:"查看商品"},"vertical","contain")
fit = Col([Title("用法不同，选择也不同","lg"),Table(["使用条件","先核对什么"],[["读完需要收起来","先比较折叠款的尺寸"],["桌面几乎放不下灯座","核对夹式灯与桌沿是否匹配"],["希望移动使用","比较充电方式和续航条件"]]) ],3)
closing = Col([Title("买前别漏了这件事","md"),Text("量一下灯座能放多宽、灯头会不会挡显示器，再确认照射范围和插座位置。"),Text("还要核对灯臂可调范围、实际照明覆盖、供电接口与线长；不要从商品名称推定续航或护眼效果。","sm","muted"),Button("按我的桌面条件缩小选择",@ToAssistant("请先问我的桌面尺寸、摆放位置和供电条件，再核对这三款台灯；不要用其他型号的资料补齐参数。",{productIDs:["971628097659","1014479690931","1087331917809"]}),"outline") ],3)
