root = Col([hero,intro,dayOne,dayTwo,mapSection,ticketSection,comparison,conclusion ])
hero = Col([Caption("HANGZHOU · A VISUAL JOURNEY"),Title("杭州两日 · 实景预览","xl"),Image("https://p9.itc.cn/q_70/images03/20221030/ec6c914e9d9e483bb46ef2e1359a2d8b.jpeg","德寿宫宫墙，古树和游客沿红墙散步"),Caption("德寿宫红墙实拍 · 古树、宫墙与行人，是杭州很有辨识度的宋韵画面。") ],3)
intro = Col([Title("两天，两种杭州。","lg"),Text("喜欢南宋历史与文人文化，可以先从这两组景点认识这座城：第一天看宫苑、官窑和老城，第二天沿西湖寻找文人遗迹。"),Caption("照片来自不同时期的公开实景，供了解外观和空间氛围；不代表实时天气、人流或开放状态。") ],3)
dayOne = Col([Title("Day 01｜南宋临安","lg"),Caption("官窑博物馆 → 德寿宫 → 南宋遗址陈列馆"),kiln,deshou,siteCard ],6)
kiln = Col([Image("https://www.hangchow.org/data/upload/ueditor/20230106/63b787c317c37.jpg","南宋官窑博物馆室内龙窑遗址全景"),Title("01 · 杭州南宋官窑博物馆","md"),Caption("古窑址 · 青瓷 · 安静的庭院"),Text("这里主要看保护在室内的古窑址。长条形的土质结构，就是当年烧造瓷器的龙窑遗迹。"),Text("**现场感受：** 安静、朴素，有很强的考古感，更像走进宋代工匠工作过的地方。") ],3)
deshou = Col([Image("https://imagecloud.thepaper.cn/thepaper/image/225/370/576.jpg","德寿宫重华宫仿宋建筑正面实拍"),Title("02 · 南宋德寿宫遗址博物馆","md"),Caption("皇家宫苑 · 红墙 · 地下遗址"),Text("地面是依历史资料营造的宋韵建筑群，真正的南宋遗址保留在地下。"),Carousel([courtyard,ruins],288,4),Text("**现场感受：** 地上开阔、庄重；地下光线较暗，像走进一座沉浸式考古博物馆。") ],3)
courtyard = Col([Image("https://hznews.hangzhou.com.cn/chengshi/content/2022-11/18/8ef4e822-a19e-4ed4-bc72-1ea847fb06bf_zsize.png","德寿宫室外红墙和院落实景"),Caption("室外 · 红墙")])
ruins = Col([Image("https://dimg04.c-ctrip.com/images/1mh0t12000al0nz2w4226_W_640_10000.jpg?proc=autoorient","德寿宫地下遗址展厅与保护展示空间"),Caption("室内 · 遗址展区")])
siteCard = Col([Image("https://z.hangzhou.com.cn/2022/syjy/images/2022-12/09/d809c897-a59f-46fb-8f43-1797ddec8e68.jpg","南宋遗址陈列馆入口建筑实拍"),Title("03 · 南宋遗址陈列馆","md"),Caption("小型考古展馆"),Text("入口低调，主要看馆内的南宋街道遗迹。") ],3)
dayTwo = Col([Title("Day 02｜西湖文脉","lg"),Caption("苏堤 → 岳王庙 → 孤山与林逋遗迹"),sudi,Grid([yueCard,gushanCard],2,160,4),dongpoExtra ],6)
sudi = Col([Image("https://img1.qunarzz.com/travel/d0/1508/b5/86a1839a0346a8.jpg_r_720x480x95_04ad6f0a.jpg","西湖苏堤石桥、柳树和湖面实景"),Title("01 · 苏堤｜在湖心走一段路","md"),Text("柳树、湖面与沿堤的石桥。这里的美不在某一个建筑，而在连续的行走体验。"),Caption("现场氛围｜开阔、松弛；苏堤全长接近 3 公里。") ],3)
yueCard = Col([Image("https://www.pelago.com/img/products/CN-China/yue-fei-temple-ticket/df78b90c-88b1-4dcf-9345-0f32d6a6d728_yue-fei-temple-ticket.jpg","岳王庙建筑实景"),Title("02 · 岳王庙","md"),Caption("传统祠庙 · 庄重肃穆"),Text("红柱重檐，墓区与碑刻庄重肃穆。") ],3)
gushanCard = Col([Image("https://youimg1.c-ctrip.com/target/fd/tg/g1/M0B/C3/49/CghzflT_pLqAB8CTABhI6i-AH8Q373.jpg","孤山放鹤亭实景"),Title("03 · 孤山与放鹤亭","md"),Caption("林逋遗迹 · 清幽园林"),Text("树荫、石阶、古亭，慢慢走更有味道。") ],3)
dongpoExtra = Disclosure("补充 · 苏东坡纪念馆",[Image("https://edu.hangzhou.com.cn/2024rdzt/zdagzyjd/images/2024-08/07/482030a1-e1f3-4cf9-875e-4df9dd93dbee.jpg","苏东坡纪念馆实拍，传统屋顶建筑立于绿荫之中"),Text("馆址位于苏堤南端附近。这里有绿荫中的传统风格纪念建筑，但距离岳王庙与孤山所在的北段较远。")])
mapSection = Col([Title("两天的地点，在地图上是什么关系？","lg"),Text("第一组主要在南宋临安城区域，第二组沿西湖和孤山展开。地图收录六个主要地点和一个补充地点；苏东坡纪念馆为补充选项。"),Map(allMarkers,false),Caption("在地图内部按天筛选，点击标记或下方地点卡片查看位置。苏东坡纪念馆位于苏堤南端，作为补充选项单独考虑。")],3)
ticketSection = Col([Title("门票与预约","lg"),Caption("以下沿用原示例的场馆信息；出发前请核对最新公告。"),Text("免费参观：德寿宫、南宋官窑博物馆、南宋遗址陈列馆；苏堤与孤山的公共游览区域也无需购买门票。"),Text("德寿宫个人参观免预约；其他场馆的周末预约要求与临时展览以当期公告为准。"),ticket,Caption("所选日期的价格、优惠与可订状态以票务页为准；此处保留原示例报价，未查询实时库存。") ],3)
ticket = ProductCard({id:"hangzhou-yuewang-temple",title:"岳王庙",images:[{url:"https://www.pelago.com/img/products/CN-China/yue-fei-temple-ticket/df78b90c-88b1-4dcf-9345-0f32d6a6d728_yue-fei-temple-ticket.jpg",alt:"岳王庙正殿建筑实拍"}],specification:"杭州 · 西湖北岸。红柱重檐的祠庙建筑与墓区、碑刻共同构成纪念岳飞的游览空间。",price:25,currency:"CNY",priceNote:"起 · 成人票 · 原示例记录",purchaseURL:"https://touch.piao.qunar.com/touch/detail.htm?id=3501705640",actionLabel:"查看票种"},"horizontal")
comparison = Col([Title("现场氛围，一眼对比","lg"),Table(["地点","实际氛围","视觉看点"],[["德寿宫","宫苑感、仪式感","红墙、复原建筑、遗址"],["官窑博物馆","安静、朴素","古窑址、青瓷、庭院"],["南宋遗址陈列馆","低调、考古感","地下街道遗迹"],["苏堤","开阔、自然","湖水、长堤、树荫"],["岳王庙","庄重、肃穆","祠庙、墓碑、殿宇"],["孤山","清幽、古朴","放鹤亭、石阶、林木"]]) ],3)
conclusion = Col([Title("哪些地方最值得认真停留？","lg"),Text("想看建筑与遗址的层次，优先德寿宫；偏好文人书画和园林细节，把时间留给孤山；希望放慢节奏看湖，就在苏堤走一段。"),Button("按我的步行能力细化两天节奏",@ToAssistant("沿南宋历史和西湖文脉两条主线细化两日行程。先问我的步行能力，再核对开放和预约信息。"),"outline") ],3)
kilnMarker = MapMarker("南宋官窑博物馆",30.21183,120.150447,"第一天")
palaceMarker = MapMarker("南宋德寿宫遗址博物馆",30.2412,120.16862,"第一天")
siteMarker = MapMarker("南宋遗址陈列馆",30.23219,120.1652,"第一天")
lakeMarker = MapMarker("苏堤中段",30.242637,120.134544,"第二天")
templeMarker = MapMarker("岳王庙",30.25474,120.12977,"第二天")
hillMarker = MapMarker("孤山放鹤亭附近",30.2542,120.138013,"第二天")
dongpoMarker = MapMarker("苏东坡纪念馆",30.231245,120.13929,"补充地点")
allMarkers = [kilnMarker,palaceMarker,siteMarker,lakeMarker,templeMarker,hillMarker,dongpoMarker]
