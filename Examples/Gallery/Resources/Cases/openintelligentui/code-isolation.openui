root = Col([intro,principle,schemes,architecture,kubernetes,recommendation,references,followUps])
intro = Col([Col([Caption("ENGINEERING · CODE EXECUTION"),Title("服务端执行用户代码：容器还是虚拟机？","2xl")]),Text("如果你要在服务端执行用户提交的任意代码，我更推荐虚拟机隔离，尤其是 MicroVM（微型虚拟机），而不是直接使用普通 Docker 容器。"),Text("但不一定需要自己管理传统虚拟机。现在有一条更实用的路线：保留容器的使用体验，底层采用虚拟机隔离。")])
principle = Col([Title("01 · 容器与虚拟机，核心区别是什么？","lg"),boundaryFigure,Text("普通容器依靠 Namespace、cgroups、seccomp 等机制隔离进程与资源。它适合运行受信任的应用，但如果用户代码利用内核漏洞，就可能影响整个宿主机。"),Text("虚拟机增加了独立内核和硬件虚拟化边界，通常更适合执行潜在恶意代码。")])
boundaryFigure = Col([Grid([containerBoundary,vmBoundary],2,160,4),Caption("普通容器共享宿主机内核；虚拟机拥有独立的 Guest Kernel，通过 Hypervisor 提供硬件虚拟化隔离边界。")],2)
containerBoundary = Card([Title("Container","md"),Text("用户代码 · 容器 A"),Text("用户代码 · 容器 B"),Divider(),Title("共享 Host Kernel","sm"),Caption("同一个宿主机内核"),Divider(),Text("Host 硬件","sm")],"soft")
vmBoundary = Card([Title("Virtual Machine","md"),Text("用户代码 · 沙箱 A"),Caption("独立 Guest Kernel"),Text("用户代码 · 沙箱 B"),Caption("独立 Guest Kernel"),Divider(),Title("Hypervisor / KVM","sm"),Text("Host 硬件","sm")],"soft")
schemes = Col([Title("02 · 四种常见隔离技术怎么选？","lg"),Table(["方案","隔离机制","典型场景"],[["Docker / runc","共享 Host Kernel","内部可信代码"],["gVisor","用户态应用内核","不可信脚本"],["Kata Containers","Pod 级 VM 隔离","K8s 多租户"],["Firecracker","KVM MicroVM","高密度执行"]]),Text("注意：这四项不处于同一抽象层。Kata Containers 是容器运行时方案，可选用 QEMU、Cloud Hypervisor、Firecracker 等 VMM；因此 Kata 和 Firecracker 并非互斥。"),Text("资源开销上，普通容器通常最轻；gVisor 引入系统调用处理开销；Kata 需要 VM 运行资源；Firecracker 针对轻量虚拟化优化，但完整冷启动仍取决于镜像、运行时和调度。"),dockerDetail,gvisorDetail,kataDetail,firecrackerDetail])
dockerDetail = Col([Title("Docker / runc · 普通容器","md"),Text("依靠 Linux Namespace、cgroups、seccomp 等内核隔离能力，多个容器共享宿主机内核。启动和资源开销通常较低，但不建议仅依赖普通容器隔离执行完全不可信的任意代码。")],3)
gvisorDetail = Col([Title("gVisor · 用户态内核隔离","md"),Text("在用户代码与宿主机内核之间加入用户态应用内核，拦截并实现大量 Linux 系统调用。可以集成 Docker、Kubernetes，适合常见的不可信脚本。"),Text("需要特别验证系统调用兼容性、I/O 性能以及目标语言运行时的行为。")],3)
kataDetail = Col([Title("Kata Containers · 容器接口 + VM 隔离","md"),Text("Kata 使用轻量虚拟机承载容器。通常一个 Kata Pod 对应一个独立 VM 沙箱，容器在 VM 内运行。"),Text("通过 Kubernetes RuntimeClass，可以在保留现有 Pod 编排体验的同时，获得更强的隔离边界。代价是虚拟机启动、内存及基础设施开销。")],3)
firecrackerDetail = Col([Title("Firecracker · 轻量 MicroVM","md"),Text("Firecracker 基于 KVM，通过精简虚拟设备和功能降低虚拟化开销，适合大规模、短生命周期的代码执行任务。"),Text("官方最小配置基准中，从启动指令到 Guest 用户态 init 可在 125ms 以内，但这个指标不包含业务镜像准备、运行时初始化和调度等完整冷启动过程。")],3)
architecture = Col([Title("03 · 服务端执行架构怎么设计？","lg"),Text("假设用户提交 Python、JavaScript、Shell，甚至编译型语言代码，执行环境应当默认视为不可信。"),architectureFigure,Title("三个关键设计点","md"),securityPoints])
architectureFigure = Col([runtimeDiagram,Caption("每个沙箱具有独立的执行环境与文件系统。调度器负责生命周期，宿主机侧负责资源和网络控制。")],2)
runtimeDiagram = Svg([Rect(35,4,290,60,"surface","muted",1,1,12),SvgText("API / Agent 服务",180,29,19,"ink","middle","semibold"),SvgText("提交代码 · 鉴权 · 租户配额",180,50,14,"ink","middle"),Line(180,64,180,86,"muted",2),Polygon("175,79 180,88 185,79","muted"),Rect(35,90,290,60,"#e5ecf6","#bdcee3",1,1,12),SvgText("Execution Scheduler",180,115,19,"#355f92","middle","semibold"),SvgText("排队 · 分配 · 超时 · 回收",180,137,14,"#355f92","middle"),Path("M180 150V169H90V188 M180 169H270V188","none","muted",2),Rect(8,190,164,134,"#eff5fc","#a9c2e0",1,1,12),Rect(188,190,164,134,"#eff5fc","#a9c2e0",1,1,12),SvgText("Sandbox A",90,215,18,"#355f92","middle","semibold"),SvgText("Python / JS",90,242,16,"#355f92","middle"),SvgText("隔离文件系统",90,273,15,"#355f92","middle"),SvgText("Guest Kernel · VM",90,306,14,"#355f92","middle"),SvgText("Sandbox B",270,215,18,"#355f92","middle","semibold"),SvgText("Shell",270,242,16,"#355f92","middle"),SvgText("隔离文件系统",270,273,15,"#355f92","middle"),SvgText("Guest Kernel · VM",270,306,14,"#355f92","middle"),Rect(8,342,344,60,"surface","muted",1,1,12),SvgText("宿主机节点池",180,367,18,"ink","middle","semibold"),SvgText("资源计量 · 网络出口控制",180,390,15,"ink","middle")],"0 0 360 408","代码执行隔离架构：服务、调度与独立沙箱")
securityPoints = List([ListItem("隔离粒度","短任务可以每次执行创建一个沙箱；有状态 Agent 可按会话分配沙箱。不同不可信租户默认使用不同的 VM 安全边界。"),ListItem("预热机制","高频代码执行可建立 Warm Pool，提前准备沙箱或基础镜像，减少重复初始化的等待时间。"),ListItem("安全约束","默认关闭外网；按需开放出口白名单。限制 CPU、内存、PID、磁盘、执行时长与日志大小。不要暴露宿主机 Docker Socket、云凭证和 K8s ServiceAccount Token。")],"number",true)
kubernetes = Col([Title("04 · 如果已经使用 Kubernetes","lg"),Text("我更倾向于先落地 K8s + Kata Containers，而不是直接自己管理 Firecracker。"),Text("一个 Pod 可以通过 `runtimeClassName` 指定虚拟机隔离的运行时："),runtimeExample])
runtimeExample = Col([Code("apiVersion: v1\nkind: Pod\nmetadata:\n  name: user-code-runner\nspec:\n  runtimeClassName: kata-qemu-runtime-rs\n  automountServiceAccountToken: false\n  restartPolicy: Never\n  containers:\n    - name: runner\n      image: your-runner-image:tag\n      resources:\n        limits:\n          cpu: '1'\n          memory: 512Mi","yaml"),Caption("示例中的 RuntimeClass 名称取决于实际安装配置，镜像名称也是占位符。这只是运行时选型示例，不是完整生产安全配置。Kata 需要支持 KVM 的宿主节点，普通云主机不一定支持嵌套虚拟化。")],2)
recommendation = Col([Title("05 · 按现有条件选型","lg"),primaryRecommendation,firecrackerChoice,gvisorChoice,Caption("选型还需要明确沙箱按任务还是按会话创建、何时复用、何时销毁。")],6)
primaryRecommendation = Col([Title("优先评估 Kata Containers","md"),Row([Badge("已有 K8s"),Badge("需 KVM")],2,"center","start",true),Text("运行时兼容性验证通过后，可保留 Pod 编排方式，以独立 VM 提供隔离边界。仍需配合网络、凭证、存储及资源约束。")],3)
firecrackerChoice = Col([Title("Firecracker","md"),Row([Badge("高频短任务"),Badge("自建调度")],2,"center","start",true),Text("适合追求低冷启动和高密度执行，并愿意投入宿主机、镜像、快照、网络及调度工程的平台；需要配套执行调度。")],3)
gvisorChoice = Col([Title("gVisor","md"),Badge("轻量脚本"),Text("保留容器使用方式，适合目标语言和系统调用兼容性满足要求的场景；上线前仍需验证兼容性与实际性能。")],3)
references = Col([Title("参考资料","sm"),Citation([{title:"Kubernetes RuntimeClass",url:"https://kubernetes.io/docs/concepts/containers/runtime-class/"},{title:"Kata Containers",url:"https://github.com/kata-containers/kata-containers/blob/main/docs/design/virtualization.md"},{title:"gVisor",url:"https://gvisor.dev/docs/architecture_guide/intro/"},{title:"Firecracker",url:"https://github.com/firecracker-microvm/firecracker/blob/main/SPECIFICATION.md"}])],2)
followUps = Col([Button("如何设计沙箱的创建、复用和销毁策略？",@ToAssistant("如何设计沙箱的创建、复用和销毁策略？")),Button("已有 Kubernetes 时，怎样验证 Kata 的运行时兼容性？",@ToAssistant("已有 Kubernetes 时，怎样验证 Kata 的运行时兼容性？"),"outline")],3)
