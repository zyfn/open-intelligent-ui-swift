root = Col([intro,overview,temperature,mechanism,modes,efficiency,winter,conclusion,followUps])
$mode = "heating"
intro = Col([Caption("EXPLAINED · HEAT PUMP"),Title("冬天空调为什么能把屋里变暖？","xl"),Text("空调冬天能制热，其实是因为它有一种很巧妙的能力：**把室外的热量搬到室内，而不是直接制造热量。**"),Text("它的原理叫作 **热泵（Heat Pump）**，你可以把它理解成一台能够反向工作的冰箱。")],3)
overview = Col([Title("核心概览","lg"),Caption("两件事就能理解空调制热"),Grid([heatSource,heatDirection],2,150,4)],3)
heatSource = Card([Caption("热量从哪里来"),Title("室外空气","md"),Text("低温空气中仍然有热量。","sm")],"soft")
heatDirection = Card([Caption("热量往哪里去"),Title("室外 → 室内","md"),Text("压缩机驱动热量搬运。","sm")],"soft")
temperature = Col([Title("01 · 冬天室外那么冷，哪来的热量？","lg"),Text("这是最容易困惑的地方。**温度低不代表没有热量。** 即使室外只有 0℃，空气中的分子仍然在运动，仍然具有热能。"),Text("只要空调内部的制冷剂温度比室外空气更低，就能从室外吸收热量。"),Grid([air,coolant],2,150,4),Text("热量就能从 0℃ 的空气流向 -15℃ 的制冷剂。上述温度仅为原理示例，不是空调运行时的固定值。"),Text("然后，空调通过压缩机把制冷剂变成高温高压状态，再把热量释放到室内。")],3)
air = Card([Caption("室外空气"),Title("0℃","xl")])
coolant = Card([Caption("制冷剂"),Title("−15℃","xl")])
mechanism = Col([Title("02 · 空调是怎么搬运热量的？","lg"),heatDiagram,Caption("图解｜室外机吸热，压缩机升温加压，室内机释放热量。图示为简化原理，并非实际管路。"),mechanismSteps],3)
heatDiagram = Svg([Rect(6,8,138,160,"#e5f1fb",null,null,null,16),Rect(216,8,138,160,"#fcf0e3",null,null,null,16),SvgText("室外 0℃",75,35,18,"#356b91","middle","semibold"),SvgText("室内 22℃",285,35,18,"#9e622e","middle","semibold"),Path("M38 55q-10 12 0 24t0 24 M58 55q-10 12 0 24t0 24 M78 55q-10 12 0 24t0 24","none","#6a9bc0",3),Path("M260 55q-10 12 0 24t0 24 M280 55q-10 12 0 24t0 24 M300 55q-10 12 0 24t0 24","none","#de9256",3),SvgText("吸收热量",75,140,16,"#356b91","middle"),SvgText("释放热量",285,140,16,"#9e622e","middle"),Rect(124,65,112,58,"#f6dfc6",null,null,null,12),SvgText("压缩机",180,89,18,"#684523","middle","semibold"),SvgText("升温加压",180,111,14,"#684523","middle"),Line(120,154,231,154,"#d88943",5),Polygon("224,147 237,154 224,161","#d88943"),Path("M285 172v24H75v-24","none","#7e9fba",2),SvgText("制冷剂循环 · 热量向室内转移",180,222,16,"ink","middle")],"0 0 360 240","空调热泵制热循环示意",360,240)
mechanismSteps = List([ListItem("室外吸热","低温制冷剂吸收室外空气中的热量，逐渐蒸发。","1"),ListItem("压缩升温","压缩机对气态制冷剂做功，使其温度和压力升高。","2"),ListItem("室内放热","高温制冷剂在室内机冷凝，释放热量，风扇吹出热风。","3"),ListItem("降压降温","制冷剂经过节流装置降压降温，再次回到室外吸热。","4")],"number",true)
modes = Col([Title("03 · 空调制冷和制热有什么区别？","lg"),Text("本质上是同一套原理，只不过热量搬运方向相反。"),Grid([summer,winterMode],2,150,4),SegmentedControl($mode,[{value:"heating",label:"冬季制热"},{value:"cooling",label:"夏季制冷"}],true),Text($mode=="heating"?"室外吸热 → 压缩升温 → 室内放热":"室内吸热 → 压缩升温 → 室外放热","md","ink","semibold"),Text("能够制冷制热的空调，通常通过 **四通换向阀** 切换制冷剂的流动路径，从而改变室内外换热器的作用。")],3)
summer = Card([Caption("夏天制冷"),Title("室内 → 室外","md"),Text("室内热量搬到室外。","sm")])
winterMode = Card([Caption("冬天制热"),Title("室外 → 室内","md"),Text("室外热量搬到室内。","sm")])
efficiency = Col([Title("04 · 为什么空调制热有时比电暖器省电？","lg"),Text("电暖器主要是把电能直接转化为热量，而热泵空调还从室外搬来了额外的热量。"),Text("**假设两台设备各消耗 1 度电**"),Chart("bar",[{device:"普通电暖器","输入电能":1,"环境热量":0},{device:"热泵空调","输入电能":1,"环境热量":2.5}],"device",["输入电能","环境热量"],"number",true,220),Caption("两组柱形区分输入电能与从室外搬来的热量。图中热泵按 3.5 度热量示意；实际效率取决于设备性能和运行工况。"),Text("热泵空调的制热性能系数（COP）可以大于 1，并不违反能量守恒，因为多出来的热量来自室外环境。"),Text("不过，室外温度较低时，热泵的制热效率和能力通常会下降。室外机还可能结霜，需要定期除霜，所以空调有时会短暂停止吹热风。")],3)
winter = Disclosure("进一步理解 · 化霜与辅助电加热",[Text("室外换热器结霜会影响换热，设备需要化霜，期间室内供热可能暂时减弱或停止。"),Text("是否启用辅助电加热以及适合的运行范围，应看具体机型说明。"),Text("短暂化霜和持续无法升温是不同情况；检查时需要结合机型、环境与实际运行状态。")])
conclusion = Col([Title("一句话总结","lg"),Text("空调制热的本领，不是用电直接烧出热量，而是用电驱动压缩机，把室外本来就存在的热量搬进屋里。")],3)
followUps = Col([Button("制热时温度和风速怎么设置更舒服？",@ToAssistant("制热时温度和风速怎么设置更舒服？")),Button("一直开空调和频繁开关，哪种更省电？",@ToAssistant("一直开空调和频繁开关，哪种更省电？"),"outline")],3)
