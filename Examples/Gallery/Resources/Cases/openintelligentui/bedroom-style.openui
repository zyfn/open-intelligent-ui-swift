root = Col([intro,chooser,improvements,advice,closing ])
$natural = false
$quiet = false
$vintage = false
selected = @Concat(@Concat($natural?["自然松弛"]:[],$quiet?["安静克制"]:[]),$vintage?["温暖复古"]:[])
intro = Col([Caption("BEDROOM · FIND YOUR FEELING"),Title("先找到愿意每天待着的感觉","xl"),Text("我建议先别急着给卧室定一个「日式」「北欧」之类的风格标签。**先找到一种你愿意每天回家后待在里面的感觉**，再考虑家具、颜色和装饰。"),Text("先看看三种配色、灯光和材质不同的卧室，凭直觉选择吸引你的部分，再逐步确认自己的偏好。") ],3)
chooser = Col([Title("01｜找到你喜欢的卧室氛围","lg"),Caption("可多选；选好后一起生成布置建议。"),Form([Carousel([natural,quiet,vintage],288,4),selectedSummary,continueChoice]) ],3)
natural = Card([Image("https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=900&q=85","自然松弛、浅木色和暖白床品的卧室"),Title("A · 自然松弛","md"),Text("奶油白、浅木、棉麻；像阳光晒过的房间。"),Checkbox($natural,"喜欢自然松弛")])
quiet = Card([Image("https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=900&q=85","安静克制、柔和照明的卧室"),Title("B · 安静克制","md"),Text("深木、亚麻、间接暖光；安静而有秩序。"),Checkbox($quiet,"喜欢安静克制")])
vintage = Card([Image("https://images.unsplash.com/photo-1615874694520-474822394e73?w=900&q=85","胡桃木与复古氛围的温暖卧室"),Title("C · 温暖复古","md"),Text("胡桃木、藤编、焦糖色；温润、有生活感。"),Checkbox($vintage,"喜欢温暖复古")])
selectedSummary = Text(@Count(selected)==0?"先看看图片，选出你喜欢的部分。":"你选中了："+@Join(selected,"、"),"sm","muted")
continueChoice = Button("生成布置建议",@ToAssistant("根据我选择的卧室氛围，提炼共同偏好，给出适合出租房的配色、灯光和软装建议。优先不破坏房屋、可搬走的改变，暂不推荐具体商品。",{preferences:selected}),"solid","primary","md",null,@Count(selected)==0,true)
improvements = Col([Title("02｜舒服，不一定需要重新装修","lg"),Carousel([lighting,fabric,space],260,4) ],3)
lighting = Col([Image("https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=800&q=85","灯光氛围参考"),Col([Title("灯光"),Text("用低位暖光代替刺眼的顶灯。")],2)],3)
fabric = Col([Image("https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=800&q=85","织物氛围参考"),Col([Title("织物"),Text("用床品和窗帘增加柔软质感。")],2)],3)
space = Col([Image("https://images.unsplash.com/photo-1778145792155-708f364bd772?auto=format&fit=crop&fm=jpg&ixid=NHwxMjA3fDA%3D&ixlib=rb-4.1.0&q=60&w=3000","留白氛围参考"),Col([Title("留白"),Text("少放零碎装饰，让空间能呼吸。")],2)],3)
advice = Card([Title("租来的卧室，先从可撤回的改变开始","sm"),Text("如果是租来的卧室，建议先调整灯光、床品和窗帘，再考虑家具。优先选择可以撤回、也方便搬走的改变。")],"soft")
closing = Col([Text("**不必追求纯粹的一种风格。** 喜欢 A 的配色、B 的灯光，完全可以组合成你自己的卧室。"),Text("等确认喜欢的氛围，我们再结合房间尺寸和现有家具，把它落实成具体布置。"),Caption("照片仅作氛围参考。选择保存在本页；继续讨论只记录本地动作，不连接外部服务。") ],3)
