root = Col([cover, sameDayIntro, current, comparison, note, history, next])
cover = Col([Caption("BEIJING → BANGKOK · TRANSPORT OPTIONS"), Title("直飞还是中转？", "xl"), Text("以下均为固定演示数据，不是实时航班。先比较出发、抵达和衔接，再决定要重新查询哪种方案。")])
current = Grid([directChoice, transferChoice], 2, 300, 4)
directChoice = Card([Title("直飞 · 同日演示", "md"), Row([Col([Title("10:00"), Text("北京大兴"), Caption("PKX")]), JourneyLine("flight"), Col([Title("14:05"), Text("曼谷素万那普"), Caption("BKK")])]), Caption("5 小时 5 分 · UTC+8 → UTC+7"), Row([Col([Title("¥950", "lg"), Caption("1 成人单程经济舱 · mock")]), Link("查看演示来源", "/transport/direct?date=2026-11-21")]), Button("重新查询直飞", @ToAssistant("请重新查询 2026-11-21 北京大兴到曼谷素万那普的直飞，1 位成人、单程经济舱，并核对含税总价、行李与退改。当前页面价格仅为演示。", {date:"2026-11-21", from:"PKX", to:"BKK", preference:"direct", adults:1}), "outline")])
transferChoice = Card([Title("上海中转 · 同日演示", "md"), Col([Row([Col([Title("09:00"), Text("北京大兴"), Caption("PKX")]), JourneyLine("flight"), Col([Title("11:00"), Text("上海浦东"), Caption("PVG")])]), Caption("同机场衔接 2 小时；联程与行李直挂待核实"), Row([Col([Title("13:00"), Text("上海浦东"), Caption("PVG")]), JourneyLine("flight"), Col([Title("16:00"), Text("曼谷素万那普"), Caption("BKK")])])]), Caption("总用时演示 8 小时 · UTC+8 → UTC+7"), Row([Col([Title("¥820", "lg"), Caption("1 成人单程经济舱 · mock")]), Link("查看演示来源", "/transport/transfer?date=2026-11-21")]), Button("重新查询中转", @ToAssistant("请重新查询 2026-11-21 北京大兴到曼谷素万那普经上海浦东的方案，1 位成人、单程经济舱，核对是否联程、行李、转机保障与含税总价。当前页面价格仅为演示。", {date:"2026-11-21", from:"PKX", to:"BKK", via:"PVG", adults:1}), "outline")])
comparison = Table(["同日演示条件", "直飞", "中转"], [["出发 / 抵达", "10:00 → 14:05", "09:00 → 16:00"], ["总用时", "5 小时 5 分", "8 小时"], ["衔接", "无", "上海浦东，同机场 2 小时"], ["演示价", "¥950", "¥820"]])
note = Card([Title("如何理解这组差异", "md"), Text("中转演示价少 ¥130，但总用时多 2 小时 55 分钟，并增加一次衔接。这个差价只在同日、同人数、同舱位口径内成立。换乘、联程、行李和退改都需要重新查询确认。"), Caption("JourneyLine 只表达两端之间的交通方式，不代表路线、时长或中转事实。")])
next = Col([Title("下一步", "lg"), Text("如果你更在意价格、时间或少折腾，可以告诉我优先级，再按同一日期和人数重新查询。"), Caption("这里沿用 2026/11/21、1 位成人的同日演示条件；历史日期请使用上方历史记录入口。"), Button("按我的偏好重新查", @ToAssistant("先问我更在意价格、总用时还是减少中转，再按本页日期和人数重新查询真实航班。不要沿用演示报价。", {date:"2026-11-21", from:"PKX", to:"BKK", adults:1}), "outline")])
sameDayIntro = Col([Title("同日比较 · 演示方案", "lg"), Text("同为 11 月 21 日出发、1 位成人、单程经济舱，先看直飞与同机场中转的取舍。以下两条为演示数据，并非实时航班；时间均为机场当地时间。"), Caption("两种演示均在当日抵达曼谷，报价含税；中国 UTC+8，泰国 UTC+7。未设定真实航班号、库存、行李直挂与退改条件。")], 2)
history = Col([historyIntro, historyEntries, historySource, historyQuery])
historyIntro = Col([Title("灵活日期 · 历史记录", "lg"), Text("以下保留原示例 11/18、11/22、11/26、11/27 的记录，不能用跨日期价差推断直飞或中转更划算。")], 2)
historyEntries = Col([historicalDirect, Divider(), historicalTransfer, Divider(), historicalA, Divider(), historicalB])
historicalDirect = Col([Caption("2026-11-27 · 泰国越捷航空 · VZ3719 · 经济舱"), historicalDirectJourney, Caption("5小时5分 · 直飞"), Text("11/28 凌晨抵达；确认住宿能否衔接实际到达时间。"), Row([Col([Title("¥729", "lg"), Caption("每人 · 单程经济舱")], 0), Link("查看 11/27 航班", directUrl)], 3, "center", "between", true)], 3)
historicalDirectJourney = Row([Col([Title("23:45", "lg"), Text("北京大兴")], 1), JourneyLine("flight"), Col([Title("03:50", "lg"), Text("曼谷素万那普"), Caption("11/28 · 次日抵达")], 1)])
historicalTransfer = Col([Caption("2026-11-26 · 东航 · MU6641 · 经济舱"), historicalTransferFirstLeg, Text("**需换机场**：10:35 抵达成都双流，15:05 从成都天府出发；确认跨机场接驳与行李安排。"), historicalTransferSecondLeg, Caption("10小时50分 · 1 次中转"), Row([Col([Title("¥721", "lg"), Caption("每人 · 单程经济舱")], 0), Link("查看 11/26 航班", transferUrl)], 3, "center", "between", true)], 3)
historicalTransferFirstLeg = Row([Col([Title("07:25", "lg"), Text("北京大兴")], 1), JourneyLine("flight"), Col([Title("10:35", "lg"), Text("成都双流")], 1)])
historicalTransferSecondLeg = Row([Col([Title("15:05", "lg"), Text("成都天府")], 1), JourneyLine("flight"), Col([Title("17:15", "lg"), Text("曼谷素万那普")], 1)])
historicalA = Col([Caption("2026-11-18 · 泰国越捷航空 · VZ3719 · 经济舱"), historicalAJourney, Caption("5小时5分 · 直飞"), Text("11/19 凌晨抵达；确认住宿能否衔接实际到达时间。"), Row([Col([Title("¥791", "lg"), Caption("每人 · 单程经济舱")], 0), Link("查看 11/18 航班", alternativeAUrl)], 3, "center", "between", true)], 3)
historicalAJourney = Row([Col([Title("23:45", "lg"), Text("北京大兴")], 1), JourneyLine("flight"), Col([Title("03:50", "lg"), Text("曼谷素万那普"), Caption("11/19 · 次日抵达")], 1)])
historicalB = Col([Caption("2026-11-22 · 泰国越捷航空 · VZ3719 · 经济舱"), historicalBJourney, Caption("5小时5分 · 直飞"), Text("11/23 凌晨抵达；确认住宿能否衔接实际到达时间。"), Row([Col([Title("¥791", "lg"), Caption("每人 · 单程经济舱")], 0), Link("查看 11/22 航班", alternativeBUrl)], 3, "center", "between", true)], 3)
historicalBJourney = Row([Col([Title("23:45", "lg"), Text("北京大兴")], 1), JourneyLine("flight"), Col([Title("03:50", "lg"), Text("曼谷素万那普"), Caption("11/23 · 次日抵达")], 1)])
historySource = Caption("上方同日比较为 mock；灵活日期组沿用 2026-11-10 的历史示例报价。历史链接只对应各卡所列日期，行李、退改、库存及结算金额以重新查询为准。")
historyQuery = Button("按历史记录重新查询", @ToAssistant("请先确认我要查询的日期和人数，再按这组历史行程条件重新查询。直飞记录均为次日抵达，成都中转记录需要从双流换到天府机场。核对住宿衔接、跨机场接驳、行李、退改和含税总价；不要把历史金额或链接当作当前库存与报价。", {sourceDate:"2026-11-10", from:"北京大兴", to:"曼谷素万那普", cabin:"经济舱", records:[{date:"2026-11-27", arrivalDate:"2026-11-28", arrivalDayOffset:1, flight:"VZ3719", historicalPrice:"¥729", sourceUrl:directUrl}, {date:"2026-11-26", flight:"MU6641", changeStation:true, transferArrival:"成都双流 10:35", transferDeparture:"成都天府 15:05", historicalPrice:"¥721", sourceUrl:transferUrl}, {date:"2026-11-18", arrivalDate:"2026-11-19", arrivalDayOffset:1, flight:"VZ3719", historicalPrice:"¥791", sourceUrl:alternativeAUrl}, {date:"2026-11-22", arrivalDate:"2026-11-23", arrivalDayOffset:1, flight:"VZ3719", historicalPrice:"¥791", sourceUrl:alternativeBUrl}]}), "outline")
