{
  "name": "@open-intelligent-ui/react-native-pilot",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "jest --config jest.config.cjs --runInBand",
    "contract": "node --import tsx scripts/export-contract.ts",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "export:ios": "expo export --platform ios --output-dir ../../outputs/react-native/ios",
    "export:android": "expo export --platform android --output-dir ../../outputs/react-native/android"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "@openuidev/lang-core": "1.1.1",
    "@openuidev/react-lang": "1.1.1",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@types/geojson": "7946.0.16",
    "entities": "8.1.0",
    "expo": "55.0.32",
    "expo-system-ui": "55.0.22",
    "fast-xml-parser": "5.12.1",
    "marked": "18.2.0",
    "prismjs": "1.30.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.15.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/prismjs": "1.26.5",
    "@types/react": "19.2.2",
    "jest": "29.7.0",
    "jest-expo": "55.0.22",
    "react-test-renderer": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react-dom": "19.2.0"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
